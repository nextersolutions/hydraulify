  "assumptions": [
    {
      "subject": "MG1",
      "statement": "One motor-generator serves both modes, with a clutch to the expander and a clutch to the LP compressor; only one clutch is engaged at a time.",
      "rationale": "Asked first: the shaft arrangement was stated as a shared machine."
    },
    {
      "subject": "HX3",
      "statement": "The preheater is fired by flue gas from outside the drawing, which is what makes the plant diabatic.",
      "rationale": "Asked first: the heat source was stated as combustion."
    },
    {
      "subject": "C2",
      "statement": "The HP stage has its own motor, because a compressor has one shaft end and the LP stage takes the shared machine's.",
      "rationale": "Two stages were asked for; the drive of the second was not stated."
    },
    {
      "subject": "ACC1",
      "statement": "Drawn as direct contact, air over water with no separator, as a water-compensated store is built.",
      "rationale": "The separating element was not stated."
    },
    {
      "subject": "T1",
      "statement": "Drawn in the ISO 1219 fluid-power form; set meta.machine_style to iso10628 for the process-plant trapezoid.",
