  "assumptions": [
    {
      "subject": "CB1",
      "statement": "Load holding uses an externally piloted counterbalance valve in the cap line, piloted from the rod line.",
      "rationale": "The requirement was functional: hold position when the valve centres. A counterbalance valve holds an overrunning load and releases on pressure in the opposite line."
    },
    {
      "subject": "V1",
      "statement": "Drawn with a closed centre so both actuator lines are blocked at rest.",
      "rationale": "A float or open centre would connect the actuator to tank and the load would not be held."
    }
  ]
